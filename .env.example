# Monetization (catalog pages only — landing stays ad-free)
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-5636736680811463
NEXT_PUBLIC_ADS_SLOT_TOP=top-banner
NEXT_PUBLIC_ADS_SLOT_SIDEBAR=sidebar
NEXT_PUBLIC_ADS_SLOT_IN_CONTENT=in-content
NEXT_PUBLIC_ADS_SLOT_BOTTOM=bottom-banner

# Catalog automation / local AI assist
# In GitHub Actions set these as repository Secrets (not committed).
# Prefer Gemini (Google Search grounding + Pro model):
AI_PROVIDER=google
AI_API_KEY=
# Or: GEMINI_API_KEY / GOOGLE_API_KEY
AI_MODEL=gemini-2.5-pro
AI_GOOGLE_SEARCH=true
# OpenAI-compatible fallback only:
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
AI_APPLY=false
AI_MAX_ITEMS=12
AI_BATCH_SIZE=4

# Dataset-use bibliography discovery
# A free OpenAlex key raises the API budget for full-catalog scans.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
# Required for the optional grounded blog/explainer scan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DATASET_USE_APPLY=false
DATASET_USE_MAX=12
# Optional comma-separated slugs for a focused or resumable run.
DATASET_USE_SLUGS=
